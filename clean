#!/bin/bash
set -euo pipefail

PATTERNS=(
  -name '*.pyc' -o
  -name '*~' -o
  -name '.ipynb_checkpoints' -o
  -name '__pycache__')

if [ "${1:-}" = "terraform" ]; then
    PATTERNS+=(-o
      -name '.terraform' -o
      -name '.terraform.lock.hcl')
fi

find . \( "${PATTERNS[@]}" \) -exec rm -rf {} +
